#include <cstdint>
#include <cstdio>
#include <fstream>
#include <limits>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t *shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo *tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expression) do { \
    const aclError result = (expression); \
    if (result != ACL_SUCCESS) { \
        std::fprintf(stderr, "%s failed: %d\n", #expression, result); \
        return 1; \
    } \
} while (0)

#ifdef CANNLAB_KERNEL_FILE
#include CANNLAB_KERNEL_FILE
#elif defined(CANNLAB_USE_NEW_DESIGN)
#include "experiments/new_design/kernel.asc"
#else
#include "kernel.asc"
#endif

int main()
{
    uint32_t batch = 0;
    uint32_t m = 0;
    uint32_t n = 0;
    uint32_t k = 0;
    int32_t dtype = 0;
    uint32_t transposeX1 = 0;
    uint32_t transposeX2 = 0;
    std::ifstream caseFile("./input/case.txt");
    if (!(caseFile >> batch >> m >> n >> k >> dtype >> transposeX1 >> transposeX2) ||
        batch == 0 || m == 0 || n == 0 || k == 0 ||
        (dtype != 1 && dtype != 2) || transposeX1 > 1 || transposeX2 > 1) {
        std::fprintf(stderr, "input/case.txt must contain: B M N K dtype transposeX1 transposeX2\n");
        return 1;
    }
    const size_t x1Bytes = static_cast<size_t>(batch) * m * k * sizeof(uint16_t);
    const size_t x2Bytes = static_cast<size_t>(batch) * k * n * sizeof(uint16_t);
    const size_t outputBytes = static_cast<size_t>(batch) * sizeof(float);
    int64_t cubeCoreCount = 0;
    aclrtStream stream = nullptr;
    void *x1Host = nullptr;
    void *x2Host = nullptr;
    void *yHost = nullptr;
    void *x1Device = nullptr;
    void *x2Device = nullptr;
    void *yDevice = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    ACL_CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &cubeCoreCount));
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMallocHost(&x1Host, x1Bytes));
    ACL_CHECK(aclrtMallocHost(&x2Host, x2Bytes));
    ACL_CHECK(aclrtMallocHost(&yHost, outputBytes));
    ACL_CHECK(aclrtMalloc(&x1Device, x1Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&x2Device, x2Bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&yDevice, outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    if (!ReadFile("./input/x1.bin", x1Bytes, x1Host, x1Bytes) ||
        !ReadFile("./input/x2.bin", x2Bytes, x2Host, x2Bytes)) {
        std::fprintf(stderr, "input files are missing or have the wrong size\n");
        return 1;
    }
    float *yHostValues = static_cast<float *>(yHost);
    for (uint32_t i = 0; i < batch; ++i) {
        yHostValues[i] = std::numeric_limits<float>::quiet_NaN();
    }
    ACL_CHECK(aclrtMemcpy(x1Device, x1Bytes, x1Host, x1Bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(x2Device, x2Bytes, x2Host, x2Bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(yDevice, outputBytes, yHost, outputBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    int64_t x1Shape[] = {
        static_cast<int64_t>(batch),
        static_cast<int64_t>(transposeX1 ? k : m),
        static_cast<int64_t>(transposeX1 ? m : k)};
    int64_t x2Shape[] = {
        static_cast<int64_t>(batch),
        static_cast<int64_t>(transposeX2 ? n : k),
        static_cast<int64_t>(transposeX2 ? k : n)};
    int64_t yShape[] = {static_cast<int64_t>(batch)};
    TensorInfo x1Tensor[] = {{x1Shape, 3, dtype}};
    TensorInfo x2Tensor[] = {{x2Shape, 3, dtype}};
    TensorInfo yTensor[] = {{yShape, 1, 0}};
    TensorGroupInfo x1Info = {x1Tensor, 1};
    TensorGroupInfo x2Info = {x2Tensor, 1};
    TensorGroupInfo yInfo = {yTensor, 1};

    // ACL returns generic host-side pointer values, while GM_ADDR carries
    // the __gm__ address-space qualifier. Bridge via uintptr_t because ASC
    // rejects a direct generic-pointer to __gm__ pointer cast.
    run_kernel(
        reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(x1Device)),
        x1Info,
        reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(x2Device)),
        x2Info,
        reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(yDevice)),
        yInfo,
        cubeCoreCount,
        stream,
        transposeX1 != 0,
        transposeX2 != 0);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(yHost, outputBytes, yDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile("./output/y.bin", yHost, outputBytes)) {
        return 1;
    }

    aclrtFree(x1Device);
    aclrtFree(x2Device);
    aclrtFree(yDevice);
    aclrtFreeHost(x1Host);
    aclrtFreeHost(x2Host);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    std::printf(
        "Completed B=%u M=%u N=%u K=%u dtype=%d transposeX1=%u transposeX2=%u cores=%lld\n",
        batch, m, n, k, dtype, transposeX1, transposeX2,
        static_cast<long long>(cubeCoreCount));
    return 0;
}
