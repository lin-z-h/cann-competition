#include <cstdint>
#include <cstdio>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t *shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo *tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expression) do { \
    const aclError result = (expression); \
    if (result != ACL_SUCCESS) { \
        std::fprintf(stderr, "%s failed: %d\n", #expression, result); \
        return 1; \
    } \
} while (0)

#include "kernel.asc"

int main()
{
    constexpr size_t inputBytes = 32 * sizeof(uint16_t);
    constexpr size_t outputBytes = sizeof(float);
    int64_t cubeCoreCount = 0;
    aclrtStream stream = nullptr;
    void *x1Host = nullptr;
    void *x2Host = nullptr;
    void *yHost = nullptr;
    void *x1Device = nullptr;
    void *x2Device = nullptr;
    void *yDevice = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    ACL_CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &cubeCoreCount));
    ACL_CHECK(aclrtCreateStream(&stream));
    ACL_CHECK(aclrtMallocHost(&x1Host, inputBytes));
    ACL_CHECK(aclrtMallocHost(&x2Host, inputBytes));
    ACL_CHECK(aclrtMallocHost(&yHost, outputBytes));
    ACL_CHECK(aclrtMalloc(&x1Device, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&x2Device, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&yDevice, outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    if (!ReadFile("./input/x1.bin", inputBytes, x1Host, inputBytes) ||
        !ReadFile("./input/x2.bin", inputBytes, x2Host, inputBytes)) {
        std::fprintf(stderr, "input files are missing or have the wrong size\n");
        return 1;
    }
    ACL_CHECK(aclrtMemcpy(x1Device, inputBytes, x1Host, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(x2Device, inputBytes, x2Host, inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    int64_t x1Shape[] = {1, 1, 32};
    int64_t x2Shape[] = {1, 32, 1};
    int64_t yShape[] = {1};
    TensorInfo x1Tensor[] = {{x1Shape, 3, 1}};
    TensorInfo x2Tensor[] = {{x2Shape, 3, 1}};
    TensorInfo yTensor[] = {{yShape, 1, 0}};
    TensorGroupInfo x1Info = {x1Tensor, 1};
    TensorGroupInfo x2Info = {x2Tensor, 1};
    TensorGroupInfo yInfo = {yTensor, 1};

    run_kernel(
        reinterpret_cast<GM_ADDR>(x1Device),
        x1Info,
        reinterpret_cast<GM_ADDR>(x2Device),
        x2Info,
        reinterpret_cast<GM_ADDR>(yDevice),
        yInfo,
        cubeCoreCount,
        stream,
        false,
        false);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(yHost, outputBytes, yDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile("./output/y.bin", yHost, outputBytes)) {
        return 1;
    }

    aclrtFree(x1Device);
    aclrtFree(x2Device);
    aclrtFree(yDevice);
    aclrtFreeHost(x1Host);
    aclrtFreeHost(x2Host);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
